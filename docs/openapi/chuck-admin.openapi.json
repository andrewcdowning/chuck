{
    "openapi": "3.0.2",
    "info": {
        "title": "ChuckAdmin",
        "version": "2025-01-01",
        "description": "The management plane: administrators manage accounts and run maintenance. Administrators see counts and sizes, never\nanyone's content, and cannot disable or delete their own account here. Every operation is refused to non-administrators\nwith 403."
    },
    "paths": {
        "/api/admin/maintenance/sweep": {
            "post": {
                "description": "Deletes stored files that no card refers to and that have not been written for ten minutes (files of deleted cards and\nattachments, replaced previews, leftovers of interrupted uploads). Also runs on a schedule. Reports counts only.",
                "operationId": "SweepOrphans",
                "responses": {
                    "200": {
                        "description": "SweepOrphans 200 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SweepOrphansResponseContent"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized 401 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UnauthorizedResponseContent"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden 403 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ForbiddenResponseContent"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "InternalError 500 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/InternalErrorResponseContent"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/admin/users": {
            "get": {
                "operationId": "ListUsers",
                "responses": {
                    "200": {
                        "description": "ListUsers 200 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ListUsersResponseContent"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized 401 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UnauthorizedResponseContent"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden 403 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ForbiddenResponseContent"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "InternalError 500 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/InternalErrorResponseContent"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/admin/users/delete": {
            "post": {
                "description": "Deletes another account and everything it owns. To keep someone out without deleting, disable the account.",
                "operationId": "DeleteUser",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/DeleteUserRequestContent"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "204": {
                        "description": "DeleteUser 204 response"
                    },
                    "400": {
                        "description": "BadRequest 400 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BadRequestResponseContent"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized 401 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UnauthorizedResponseContent"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden 403 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ForbiddenResponseContent"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "NotFound 404 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/NotFoundResponseContent"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "InternalError 500 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/InternalErrorResponseContent"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/admin/users/status": {
            "post": {
                "description": "Disables or enables an account. A disabled account is refused on every endpoint. Not allowed on your own account.\nIds are sent in the body because they may contain slashes.",
                "operationId": "SetUserStatus",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/SetUserStatusRequestContent"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "SetUserStatus 200 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/User"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "BadRequest 400 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BadRequestResponseContent"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized 401 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UnauthorizedResponseContent"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden 403 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ForbiddenResponseContent"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "NotFound 404 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/NotFoundResponseContent"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "InternalError 500 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/InternalErrorResponseContent"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "AccountStatus": {
                "type": "string",
                "enum": [
                    "active",
                    "disabled",
                    "deleting"
                ]
            },
            "BadRequestResponseContent": {
                "type": "object",
                "properties": {
                    "error": {
                        "type": "string"
                    }
                },
                "required": [
                    "error"
                ]
            },
            "DeleteUserRequestContent": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    }
                },
                "required": [
                    "id"
                ]
            },
            "ForbiddenResponseContent": {
                "type": "object",
                "properties": {
                    "error": {
                        "type": "string"
                    }
                },
                "required": [
                    "error"
                ]
            },
            "InternalErrorResponseContent": {
                "type": "object",
                "properties": {
                    "error": {
                        "type": "string"
                    }
                },
                "required": [
                    "error"
                ]
            },
            "ListUsersResponseContent": {
                "type": "object",
                "properties": {
                    "users": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/UserSummary"
                        }
                    }
                },
                "required": [
                    "users"
                ]
            },
            "NotFoundResponseContent": {
                "type": "object",
                "properties": {
                    "error": {
                        "type": "string"
                    }
                },
                "required": [
                    "error"
                ]
            },
            "Role": {
                "type": "string",
                "enum": [
                    "user",
                    "admin"
                ]
            },
            "SetUserStatusRequestContent": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "active": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "active",
                    "id"
                ]
            },
            "SweepOrphansResponseContent": {
                "type": "object",
                "properties": {
                    "scanned": {
                        "type": "number",
                        "description": "Files looked at."
                    },
                    "removed": {
                        "type": "number",
                        "description": "Unused files deleted."
                    },
                    "too_new": {
                        "type": "number",
                        "description": "Unused files left alone because they were written too recently."
                    },
                    "failed": {
                        "type": "number",
                        "description": "Files that could not be deleted; they are tried again next time."
                    }
                },
                "required": [
                    "failed",
                    "removed",
                    "scanned",
                    "too_new"
                ]
            },
            "UnauthorizedResponseContent": {
                "type": "object",
                "properties": {
                    "error": {
                        "type": "string"
                    }
                },
                "required": [
                    "error"
                ]
            },
            "User": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "display_name": {
                        "type": "string"
                    },
                    "role": {
                        "$ref": "#/components/schemas/Role"
                    },
                    "status": {
                        "$ref": "#/components/schemas/AccountStatus"
                    },
                    "created_at": {
                        "type": "number",
                        "description": "Unix seconds."
                    },
                    "last_seen_at": {
                        "type": "number",
                        "description": "Unix seconds."
                    }
                },
                "required": [
                    "created_at",
                    "id",
                    "role",
                    "status"
                ]
            },
            "UserSummary": {
                "type": "object",
                "description": "What an administrator sees about an account: counts and sizes, never content.",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "display_name": {
                        "type": "string"
                    },
                    "role": {
                        "$ref": "#/components/schemas/Role"
                    },
                    "status": {
                        "$ref": "#/components/schemas/AccountStatus"
                    },
                    "created_at": {
                        "type": "number",
                        "description": "Unix seconds."
                    },
                    "last_seen_at": {
                        "type": "number",
                        "description": "Unix seconds."
                    },
                    "notes": {
                        "type": "number"
                    },
                    "attachments": {
                        "type": "number"
                    },
                    "storage_bytes": {
                        "type": "number",
                        "description": "Total size of the account's stored files (previews not counted)."
                    }
                },
                "required": [
                    "attachments",
                    "created_at",
                    "id",
                    "notes",
                    "role",
                    "status",
                    "storage_bytes"
                ]
            }
        }
    }
}
