{
  "version": "1.0",
  "sources": ["model"],
  "maven": {
    "dependencies": ["software.amazon.smithy:smithy-aws-traits:1.75.1", "software.amazon.smithy:smithy-openapi:1.75.1"]
  },
  "projections": {
    "data": {
      "plugins": { "openapi": { "service": "chuck.api#ChuckData", "protocol": "aws.protocols#restJson1", "version": "3.0.2" } }
    },
    "control": {
      "plugins": { "openapi": { "service": "chuck.api#ChuckControl", "protocol": "aws.protocols#restJson1", "version": "3.0.2" } }
    },
    "admin": {
      "plugins": { "openapi": { "service": "chuck.api#ChuckAdmin", "protocol": "aws.protocols#restJson1", "version": "3.0.2" } }
    }
  }
}
